<?xml version="1.0" encoding="utf-8"?>
<!-- Shared MSBuild settings for the C++ projects under native/windows. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PlatformToolset>v143</PlatformToolset>
    <!-- Build output stays under native/windows/build, outside the project folders. -->
    <OutDir>$(MSBuildThisFileDirectory)build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)build\obj\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <!-- Keeps windows.h small and stops min/max macros from clashing with std. -->
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- The C headers are the ABI contract shared with the Rust core. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Self-contained WinUI apps need the hybrid CRT: the runtime and STL stay static, only the UCRT is dynamic. -->
  <Import Project="$(MSBuildThisFileDirectory)HybridCRT.props" />
</Project>

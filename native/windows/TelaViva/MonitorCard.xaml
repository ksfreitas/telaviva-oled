<UserControl
    x:Class="TelaViva.MonitorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Text, tooltips and automation names are set in code from Str(key) (ADR 0015). -->
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="NameText" Grid.Column="0"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- Shown only while presence or screensaver protection is on. -->
            <Grid x:Name="ProtectionToggleRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" Visibility="Collapsed">
                <TextBlock x:Name="ProtectionToggleText" Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <ToggleSwitch x:Name="ProtectionToggle" Grid.Column="1" MinWidth="0"
                              OnContent="" OffContent="" />
            </Grid>

            <!-- Shown instead of the brightness row while the Laptop panel drives this monitor. -->
            <Grid x:Name="FollowedRow" ColumnDefinitions="Auto,*" ColumnSpacing="12" Visibility="Collapsed">
                <FontIcon Grid.Column="0" Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" />
                <TextBlock x:Name="FollowedText" Grid.Column="1" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            </Grid>

            <Grid x:Name="BrightnessRow" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <FontIcon Grid.Column="0" Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider x:Name="BrightnessSlider" Grid.Column="0" Minimum="0" Maximum="100" StepFrequency="1" />
                        <TextBlock x:Name="BrightnessValue" Grid.Column="1" MinWidth="44"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock x:Name="BrightnessFailed" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="BrightnessReason" Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <FontIcon Grid.Column="0" Glyph="&#xE767;" FontFamily="Segoe Fluent Icons" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Slider x:Name="VolumeSlider" Grid.Column="0" Minimum="0" Maximum="100" StepFrequency="1" />
                        <TextBlock x:Name="VolumeValue" Grid.Column="1" MinWidth="44"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <TextBlock x:Name="VolumeFailed" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                    <TextBlock x:Name="VolumeReason" Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Protection brightness: the cap and the disabled state come from ProtectionRules. -->
            <StackPanel x:Name="ProtectionPanel" Spacing="2" Visibility="Collapsed">
                <TextBlock x:Name="ProtectionLabel" Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Slider x:Name="ProtectionSlider" Grid.Column="0" Minimum="0" Maximum="100" StepFrequency="1" />
                    <TextBlock x:Name="ProtectionValue" Grid.Column="1" MinWidth="44"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

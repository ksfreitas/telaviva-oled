<Window
    x:Class="TelaViva.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Text, tooltips and automation names are set in code from Str(key) (ADR 0015). -->
    <Grid x:Name="RootGrid" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Measured by the code-behind; the window height follows its desired height. -->
        <Grid x:Name="HeaderRow" Grid.Row="0" MinHeight="44" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="AppTitleText" Grid.Column="0" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1" />
            <Button x:Name="RefreshButton" Grid.Column="1" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons" />
            </Button>
        </Grid>

        <!-- Camera warning, compact and not closable; hidden unless the camera needs attention. -->
        <InfoBar x:Name="CameraInfoBar" Grid.Row="1" Severity="Warning" IsClosable="False" IsOpen="False"
                 Margin="0,8,0,0" />

        <!-- The window height comes from the measured rows (PopupLayout), so the card list gets the rows left over. -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CardsPanel" Spacing="8" />
            </ScrollViewer>
            <!-- Shown when no monitor is listed: the title, then why control is unavailable. -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="4" Margin="12,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <TextBlock x:Name="EmptyCaptionText" TextWrapping="Wrap" TextAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <!-- Shown instead of the cards when the core is not open. -->
            <StackPanel x:Name="NoticePanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" />
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="FooterPanel" Grid.Row="3" Spacing="6" Padding="4,8,4,0">
            <Grid x:Name="PresenceRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" Visibility="Collapsed">
                <FontIcon x:Name="PresenceGlyph" Grid.Column="0" Glyph="&#xE722;"
                          FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" />
                <TextBlock x:Name="PresenceText" Grid.Column="1" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
            <!-- One row: the camera line is cut with an ellipsis rather than wrapped. -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="CameraStatusText" Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <Button x:Name="SettingsButton" Grid.Column="1">
                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" />
                </Button>
                <Button x:Name="QuitButton" Grid.Column="2">
                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
